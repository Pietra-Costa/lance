import React, { useState } from "react";
import { useApp } from "../context/AppContext";
import type { Lot } from "../types/auction";
import { SellerAgreementModal } from "../components/domain/SellerAgreementModal";
import { EditLotModal } from "../components/domain/EditLotModal";
import { LotStatusBadge } from "../components/domain/LotStatusBadge";
import { ItemImage } from "../components/domain/ItemImage";
import { formatBRL, formatDateTimeBR } from "../logic/auctionRules";
import {
  Layers,
  PlusCircle,
  Gavel,
  ShieldCheck,
  AlertTriangle,
  CheckCircle2,
  Clock,
  Eye,
  XCircle,
  FileText,
  Filter,
} from "lucide-react";

/**
 * Resultado de um lote encerrado, vindo do AuctionSettlement persistido.
 *
 * Estados possíveis:
 * - sem settlement: lote ainda não encerrado
 * - COMPLETED + winningBid: arrematado, mostra valor
 * - COMPLETED sem vencedor: encerrado sem lances
 * - PENDING/PROCESSING: liquidação em andamento
 * - FAILED: liquidação falhou, precisa de atenção
 */
const SettlementResultCell: React.FC<{ lot: Lot }> = ({ lot }) => {
  const settlement = lot.settlement;

  if (!settlement) {
    return <span className="text-text-secondary text-[11px]">—</span>;
  }

  if (settlement.status === "COMPLETED") {
    if (!settlement.amountCents) {
      return (
        <span className="text-[11px] text-text-secondary">Encerrado sem lances</span>
      );
    }

    return (
      <div className="space-y-0.5">
        <span className="inline-flex items-center gap-1 text-[11px] font-semibold text-semantic-success">
          <CheckCircle2 className="w-3.5 h-3.5" />
          Arrematado
        </span>
        <span className="font-mono font-bold text-brand-primary text-xs block">
          {formatBRL(settlement.amountCents)}
        </span>
        {settlement.settledAt && (
          <span className="text-[10px] text-text-secondary block">
            {formatDateTimeBR(settlement.settledAt)}
          </span>
        )}
      </div>
    );
  }

  if (settlement.status === "FAILED") {
    return (
      <span
        className="inline-flex items-center gap-1 text-[11px] font-semibold text-semantic-error"
        title="A liquidação falhou. Verifique o histórico de auditoria do lote."
      >
        <AlertTriangle className="w-3.5 h-3.5" />
        Falha na liquidação
      </span>
    );
  }

  return (
    <span className="inline-flex items-center gap-1 text-[11px] text-semantic-warning">
      <Clock className="w-3.5 h-3.5" />
      Liquidando...
    </span>
  );
};

export const AuctioneerArea: React.FC = () => {
  const {
    currentUser,
    currentRole,
    sellerAgreement,
    lots,
    navigateTo,
    publishLot,
    cancelLot,
  } = useApp();

  const [selectedStatusFilter, setSelectedStatusFilter] =
    useState<string>("ALL");
  const [cancelModalLotId, setCancelModalLotId] = useState<string | null>(null);
  const [editLotId, setEditLotId] = useState<string | null>(null);
  const [cancellationReason, setCancellationReason] = useState<string>("");

  // Enforce Seller Agreement check
  const isAgreementSigned = !!sellerAgreement;

  // Filter lots
  // O painel lista apenas os lotes deste leiloeiro; a vitrine pública é outro
  // lugar. `lots` traz o catálogo completo para alimentar a navbar/vitrine.
  const myLots = lots.filter((lot) => lot.sellerId === currentUser?.id);

  const filteredLots = myLots.filter((lot) => {
    if (selectedStatusFilter === "ALL") return true;
    return lot.status === selectedStatusFilter;
  });

  const liveCount = myLots.filter((l) => l.status === "LIVE").length;
  const scheduledCount = myLots.filter((l) => l.status === "SCHEDULED").length;
  const endedCount = myLots.filter((l) => l.status === "ENDED").length;
  // Total recebido vem das liquidações COMPLETED persistidas pela API,
  // não de um cálculo sobre o preço atual do lote na tela.
  const totalRaisedCents = myLots.reduce((acc, l) => {
    const settlement = l.settlement;

    if (
      settlement &&
      settlement.status === "COMPLETED" &&
      settlement.settledAt
    ) {
      return acc + settlement.amountCents;
    }

    return acc;
  }, 0);

  const handleConfirmCancel = () => {
    if (cancelModalLotId && cancellationReason.trim()) {
      cancelLot(cancelModalLotId, cancellationReason.trim());
      setCancelModalLotId(null);
      setCancellationReason("");
    }
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      {/* If seller agreement not signed, block with modal */}
      {!isAgreementSigned && <SellerAgreementModal />}

      {/* Header Bar */}
      <div className="bg-brand-deep text-surface-base rounded-2xl p-6 sm:p-8 border border-brand-primary flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div className="space-y-1">
          <div className="flex items-center gap-2">
            <span className="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded bg-brand-primary text-accent-gold border border-[#C8A96A]/30">
              PAINEL OPERACIONAL
            </span>
            <span className="text-xs text-surface-base/60">
              Leiloeiro autenticado
            </span>
          </div>
          <h1 className="font-heading font-bold text-2xl sm:text-3xl text-white">
            {currentUser?.name || "Leiloeiro autenticado"}
          </h1>
          <p className="text-xs text-surface-base/70">
            Condução de pregões, gestão de lotes e importação de acervos
            culturais.
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={() => navigateTo("/leiloeiro/lotes/novo")}
            className="px-5 py-3 rounded-xl bg-[#C8A96A] hover:bg-[#C8A96A]/90 text-[#0A2B22] font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer shadow-md"
          >
            <PlusCircle className="w-4 h-4" />
            <span>Criar Novo Lote</span>
          </button>
        </div>
      </div>

      {/* Stats Cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="bg-white p-5 rounded-2xl border border-border-subtle shadow-2xs space-y-1">
          <span className="text-[11px] text-text-secondary block">
            Lotes em Pregão (Ao Vivo)
          </span>
          <p className="font-heading font-bold text-2xl text-semantic-success">
            {liveCount}
          </p>
          <span className="text-[10px] text-text-secondary">
            Recebendo lances concorrentes
          </span>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-border-subtle shadow-2xs space-y-1">
          <span className="text-[11px] text-text-secondary block">
            Lotes Agendados
          </span>
          <p className="font-heading font-bold text-2xl text-semantic-warning">
            {scheduledCount}
          </p>
          <span className="text-[10px] text-text-secondary">Início programado</span>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-border-subtle shadow-2xs space-y-1">
          <span className="text-[11px] text-text-secondary block">
            Lotes Encerrados
          </span>
          <p className="font-heading font-bold text-2xl text-brand-primary">
            {endedCount}
          </p>
          <span className="text-[10px] text-text-secondary">
            Comprovantes homologados
          </span>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-border-subtle shadow-2xs space-y-1">
          <span className="text-[11px] text-text-secondary block">
            Volume Arrematado
          </span>
          <p className="font-heading font-bold text-2xl text-brand-primary">
            {formatBRL(totalRaisedCents)}
          </p>
          <span className="text-[10px] text-text-secondary">
            Liquidações concluídas
          </span>
        </div>
      </div>

      {/* Lot Management Table */}
      <div className="bg-white rounded-2xl border border-border-subtle shadow-xs overflow-hidden space-y-4">
        <div className="p-6 border-b border-border-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 className="font-heading font-bold text-lg text-brand-primary">
              Gestão Geral de Lotes do Leiloeiro
            </h3>
            <p className="text-xs text-text-secondary mt-0.5">
              Visualize estados, acompanhe lances líderes e controle o ciclo de
              vida de cada lote.
            </p>
          </div>

          {/* Status Filter buttons */}
          <div className="flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs bg-[#FAF7F2] p-1 rounded-xl border border-border-subtle max-w-full">
            {["ALL", "LIVE", "SCHEDULED", "ENDED", "CANCELED"].map((st) => (
              <button
                key={st}
                onClick={() => setSelectedStatusFilter(st)}
                className={`px-3 py-1.5 rounded-lg font-medium transition-colors cursor-pointer shrink-0 ${
                  selectedStatusFilter === st
                    ? "bg-brand-primary text-surface-base font-semibold"
                    : "text-text-secondary hover:text-text-primary"
                }`}
              >
                {st === "ALL"
                  ? "Todos"
                  : st === "LIVE"
                    ? "Ao vivo"
                    : st === "SCHEDULED"
                      ? "Em breve"
                      : st === "ENDED"
                        ? "Encerrados"
                        : "Cancelados"}
              </button>
            ))}
          </div>
        </div>

        {/* Mobile Card View (block sm:hidden) */}
        <div className="block sm:hidden divide-y divide-border-subtle">
          {filteredLots.map((lot) => (
            <div key={lot.id} className="p-4 space-y-3">
              <div className="flex items-start gap-3">
                <div className="w-14 h-14 rounded-xl overflow-hidden shrink-0">
                  <ItemImage
                    src={lot.itemSnapshot.primaryImageUrl}
                    alt={lot.title}
                    seed={lot.id}
                    className="w-full h-full object-cover"
                    showLabel={false}
                  />
                </div>
                <div className="min-w-0 flex-1">
                  <div className="flex items-center justify-between gap-1">
                    <span className="font-mono text-[10px] text-brand-primary font-bold">
                      {lot.code}
                    </span>
                    <LotStatusBadge status={lot.status} size="sm" />
                  </div>
                  <h4 className="font-heading font-semibold text-xs text-text-primary mt-0.5 line-clamp-1">
                    {lot.title}
                  </h4>
                  {lot.settlement && (
                    <div className="mt-1">
                      <SettlementResultCell lot={lot} />
                    </div>
                  )}
                  <div className="flex items-center gap-2 mt-1 text-[10px] text-text-secondary">
                    <span className="px-1.5 py-0.5 rounded bg-[#FAF7F2] border border-border-subtle">
                      {lot.itemSnapshot.source}
                    </span>
                    <span>{lot.category}</span>
                  </div>
                </div>
              </div>

              <div className="p-2.5 bg-[#FAF7F2] rounded-xl border border-border-subtle space-y-1.5 text-xs">
                <div className="flex justify-between items-center">
                  <span className="text-text-secondary text-[11px]">
                    Lance Atual:
                  </span>
                  <span className="font-mono font-bold text-brand-primary">
                    {formatBRL(lot.currentBidCents || lot.startingPriceCents)}
                    <span className="text-[10px] font-normal text-text-secondary ml-1">
                      ({lot.bidCount} {lot.bidCount === 1 ? "lance" : "lances"})
                    </span>
                  </span>
                </div>
                <div className="flex justify-between items-center text-[11px]">
                  <span className="text-text-secondary">Líder:</span>
                  <span className="font-mono text-brand-primary">
                    {lot.currentLeaderPseudonym || "—"}
                  </span>
                </div>
              </div>

              <div className="flex items-center gap-2 pt-1">
                <button
                  onClick={() => navigateTo(`/lotes/${lot.id}`)}
                  className="flex-1 py-2 rounded-lg border border-border-strong text-text-primary hover:bg-[#FAF7F2] transition-colors cursor-pointer text-xs font-medium text-center"
                >
                  Ver Sala
                </button>

                {lot.status === "SCHEDULED" && (
                  <button
                    onClick={() => publishLot(lot.id)}
                    className="flex-1 py-2 rounded-lg bg-brand-primary text-white hover:bg-brand-deep transition-colors cursor-pointer text-xs font-semibold text-center"
                  >
                    Abrir ao Vivo
                  </button>
                )}

                {lot.status === "LIVE" && (
                  <button
                    onClick={() => setCancelModalLotId(lot.id)}
                    className="py-2 px-3 rounded-lg border border-[#B91C1C]/40 text-semantic-error hover:bg-semantic-error-bg transition-colors cursor-pointer text-xs"
                  >
                    Cancelar
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>

        {/* Desktop Table (hidden sm:block) */}
        <div className="hidden sm:block overflow-x-auto">
          <table className="w-full text-left text-xs">
            <thead className="bg-[#FAF7F2] text-text-secondary font-medium border-b border-border-subtle">
              <tr>
                <th className="py-3 px-4">Lote & Item</th>
                <th className="py-3 px-4">Fonte Externa</th>
                <th className="py-3 px-4">Estado</th>
                <th className="py-3 px-4">Lance Inicial</th>
                <th className="py-3 px-4">Lance Atual</th>
                <th className="py-3 px-4">Líder Atual</th>
                <th className="py-3 px-4">Resultado</th>
                <th className="py-3 px-4 text-right">Ações Operacionais</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-border-subtle">
              {filteredLots.map((lot) => (
                <tr
                  key={lot.id}
                  className="hover:bg-[#FAF7F2]/60 transition-colors"
                >
                  <td className="py-4 px-4 flex items-center gap-3">
                    <div className="w-12 h-12 rounded-lg overflow-hidden shrink-0">
                      <ItemImage
                        src={lot.itemSnapshot.primaryImageUrl}
                        alt={lot.title}
                        seed={lot.id}
                        className="w-full h-full object-cover"
                        showLabel={false}
                      />
                    </div>
                    <div className="min-w-0">
                      <span className="font-mono text-[10px] text-brand-primary font-bold block">
                        {lot.code}
                      </span>
                      <h4 className="font-heading font-semibold text-xs text-text-primary truncate max-w-xs">
                        {lot.title}
                      </h4>
                      <span className="text-[10px] text-text-secondary">
                        {lot.category}
                      </span>
                    </div>
                  </td>

                  <td className="py-4 px-4 text-text-secondary">
                    <span className="px-2 py-0.5 rounded bg-[#FAF7F2] border border-border-subtle text-[10px] font-medium">
                      {lot.itemSnapshot.source}
                    </span>
                  </td>

                  <td className="py-4 px-4">
                    <LotStatusBadge status={lot.status} size="sm" />
                  </td>

                  <td className="py-4 px-4 font-mono text-text-secondary">
                    {formatBRL(lot.startingPriceCents)}
                  </td>

                  <td className="py-4 px-4 font-mono font-bold text-brand-primary">
                    {formatBRL(lot.currentBidCents || lot.startingPriceCents)}
                    <span className="text-[10px] text-text-secondary block font-sans font-normal">
                      ({lot.bidCount} {lot.bidCount === 1 ? "lance" : "lances"})
                    </span>
                  </td>

                  <td className="py-4 px-4 font-mono text-xs">
                    {lot.currentLeaderPseudonym ? (
                      <span className="text-brand-primary font-semibold">
                        {lot.currentLeaderPseudonym}
                      </span>
                    ) : (
                      <span className="text-text-secondary">—</span>
                    )}
                  </td>

                  <td className="py-4 px-4">
                    <SettlementResultCell lot={lot} />
                  </td>

                  <td className="py-4 px-4 text-right space-x-1.5 whitespace-nowrap">
                    <button
                      onClick={() => navigateTo(`/lotes/${lot.id}`)}
                      className="px-2.5 py-1.5 rounded-lg border border-border-strong text-text-primary hover:bg-[#FAF7F2] transition-colors cursor-pointer text-[11px]"
                      title="Abrir sala de lances pública"
                    >
                      Ver Sala
                    </button>

                    {lot.status === "SCHEDULED" && (
                      <button
                        onClick={() => setEditLotId(lot.id)}
                        className="px-2.5 py-1.5 rounded-lg border border-border-strong text-brand-primary hover:bg-[#FAF7F2] transition-colors cursor-pointer text-[11px] font-semibold"
                        title="Editar lote antes de abrir o pregão"
                      >
                        Editar
                      </button>
                    )}

                    {lot.status === "SCHEDULED" && (
                      <button
                        onClick={() => publishLot(lot.id)}
                        className="px-2.5 py-1.5 rounded-lg bg-brand-primary text-white hover:bg-brand-deep transition-colors cursor-pointer text-[11px] font-semibold"
                        title="Abrir pregão imediatamente"
                      >
                        Abrir ao Vivo
                      </button>
                    )}

                    {lot.status === "LIVE" && (
                      <button
                        onClick={() => setCancelModalLotId(lot.id)}
                        className="px-2.5 py-1.5 rounded-lg border border-[#B91C1C]/40 text-semantic-error hover:bg-semantic-error-bg transition-colors cursor-pointer text-[11px]"
                        title="Cancelar lote com justificativa formal"
                      >
                        Cancelar
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Cancellation Modal */}
      {editLotId && (
        <EditLotModal
          lot={lots.find((item) => item.id === editLotId) as Lot}
          onClose={() => setEditLotId(null)}
        />
      )}

      {cancelModalLotId && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 border border-border-subtle shadow-2xl space-y-4">
            <div className="flex items-center gap-2 text-semantic-error">
              <AlertTriangle className="w-5 h-5 shrink-0" />
              <h3 className="font-heading font-bold text-base">
                Cancelar Lote em Andamento
              </h3>
            </div>
            <p className="text-xs text-text-secondary leading-relaxed">
              Conforme a arquitetura da plataforma Lance, o cancelamento de um
              lote ao vivo que já recebeu lances exige justificativa formal. As
              reservas dos licitantes serão liberadas imediatamente e o evento
              será registrado na cadeia de auditoria.
            </p>

            <div className="space-y-1">
              <label className="text-xs font-semibold text-text-primary block">
                Motivo / Justificativa Oficial do Cancelamento
              </label>
              <textarea
                rows={3}
                value={cancellationReason}
                onChange={(e) => setCancellationReason(e.target.value)}
                placeholder="Ex.: Solicitação judicial do proprietário original ou inconsistência cadastral."
                className="w-full p-2.5 rounded-xl border border-border-strong text-xs focus:ring-1 focus:ring-[#B91C1C]"
              />
            </div>

            <div className="flex gap-2 justify-end pt-2">
              <button
                type="button"
                onClick={() => setCancelModalLotId(null)}
                className="px-4 py-2 rounded-xl border border-border-strong text-xs text-text-secondary hover:bg-[#FAF7F2] cursor-pointer"
              >
                Voltar
              </button>
              <button
                type="button"
                disabled={!cancellationReason.trim()}
                onClick={handleConfirmCancel}
                className="px-4 py-2 rounded-xl bg-[#B91C1C] text-white text-xs font-semibold hover:bg-[#991B1B] disabled:opacity-40 cursor-pointer"
              >
                Confirmar Cancelamento e Liberar Reservas
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
