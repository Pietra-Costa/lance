import React, { useState } from "react";
import { Receipt } from "../../types/auction";
import { formatBRL, formatDateTimeBR } from "../../logic/auctionRules";
import { Logo } from "../layout/Logo";
import {
  X,
  Printer,
  ShieldCheck,
  QrCode,
  CheckCircle2,
  Copy,
  Check,
  ExternalLink,
} from "lucide-react";

import { motion } from "motion/react";

/** URL pública de verificação do comprovante (link compartilhável). */
export const receiptVerificationUrl = (verificationCode: string): string => {
  if (typeof window === "undefined") {
    return `/comprovante/${verificationCode}`;
  }

  return `${window.location.origin}/comprovante/${verificationCode}`;
};

export interface ReceiptModalProps {
  receipt: Receipt;
  onClose: () => void;
}

export const ReceiptModal: React.FC<ReceiptModalProps> = ({
  receipt,
  onClose,
}) => {
  const [copied, setCopied] = useState(false);

  const shareUrl = receiptVerificationUrl(receipt.verificationCode);

  const handlePrint = () => {
    window.print();
  };

  const handleCopyLink = async () => {
    try {
      await navigator.clipboard.writeText(shareUrl);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 2500);
    } catch {
      // Navegadores sem permissão de clipboard: seleciona o texto do campo.
      window.prompt("Copie o link de verificação:", shareUrl);
    }
  };

  return (
    <div
      className="fixed inset-0 z-50 flex items-start sm:items-center justify-center bg-black/60 backdrop-blur-xs p-0 sm:p-4 overflow-y-auto overscroll-contain"
      onClick={(event) => {
        if (event.target === event.currentTarget) onClose();
      }}
    >
      <motion.div
        initial={{ opacity: 0, scale: 0.94, y: 15 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.94, y: 15 }}
        transition={{ duration: 0.22, ease: [0.16, 1, 0.3, 1] }}
        className="bg-white rounded-none sm:rounded-2xl max-w-2xl w-full border border-border-subtle shadow-2xl sm:my-6 flex flex-col max-h-dvh sm:max-h-[92vh] overflow-hidden"
      >
        {/* Top Control Bar */}
        <div className="bg-brand-deep text-surface-base px-4 sm:px-6 py-3 flex items-center justify-between gap-2 shrink-0 print:hidden">
          <div className="flex items-center gap-2">
            <ShieldCheck className="w-4 h-4 text-accent-gold" />
            <span className="font-heading font-medium text-xs tracking-wide">
              Comprovante Oficial de Arremate · Lance
            </span>
          </div>
          <div className="flex items-center gap-2">
            <button
              onClick={handlePrint}
              className="px-2.5 py-1 rounded bg-brand-primary hover:bg-brand-primary/80 text-xs text-surface-base flex items-center gap-1.5 transition-colors cursor-pointer"
            >
              <Printer className="w-3.5 h-3.5" />
              <span>Imprimir / Salvar PDF</span>
            </button>
            <button
              onClick={onClose}
              className="p-1 rounded text-white/80 hover:text-white hover:bg-white/10"
              aria-label="Fechar"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        {/* Share bar — link público de verificação */}
        <div className="bg-surface-base border-b border-border-subtle px-4 sm:px-6 py-3 shrink-0 print:hidden">
          <div className="flex flex-col sm:flex-row sm:items-center gap-2">
            <label
              htmlFor="receipt-share-url"
              className="text-[10px] font-mono uppercase tracking-wider text-text-secondary shrink-0"
            >
              Link de verificação
            </label>
            <div className="flex flex-1 items-center gap-2">
              <input
                id="receipt-share-url"
                readOnly
                value={shareUrl}
                onFocus={(event) => event.currentTarget.select()}
                className="flex-1 min-w-0 px-3 py-1.5 rounded-lg border border-border-strong bg-white text-[11px] font-mono text-brand-primary"
              />
              <button
                onClick={handleCopyLink}
                className="px-3 py-1.5 rounded-lg bg-brand-primary text-white text-[11px] font-semibold flex items-center gap-1.5 hover:bg-brand-deep transition-colors cursor-pointer shrink-0"
              >
                {copied ? (
                  <>
                    <Check className="w-3.5 h-3.5" />
                    <span>Copiado</span>
                  </>
                ) : (
                  <>
                    <Copy className="w-3.5 h-3.5" />
                    <span>Copiar link</span>
                  </>
                )}
              </button>
              <a
                href={shareUrl}
                target="_blank"
                rel="noreferrer"
                className="px-3 py-1.5 rounded-lg border border-border-strong bg-white text-[11px] font-semibold text-brand-primary flex items-center gap-1.5 hover:border-brand-primary transition-colors shrink-0"
              >
                <ExternalLink className="w-3.5 h-3.5" />
                <span className="hidden sm:inline">Abrir</span>
              </a>
            </div>
          </div>
        </div>

        {/* Printable Certificate Layout */}
        <div className="flex-1 overflow-y-auto overscroll-contain">
          <div className="p-4 sm:p-8 bg-[#FAF7F2] relative border-4 sm:border-8 border-double border-border-subtle m-2 sm:m-4 rounded-lg sm:rounded-xl">
            {/* Subtle Background Watermark */}
            <div className="absolute inset-0 flex items-center justify-center opacity-4 pointer-events-none">
              <span className="font-heading font-black text-9xl tracking-tighter text-brand-primary">
                LANCE
              </span>
            </div>

            {/* Certificate Header */}
            <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
              <Logo variant="light" size="lg" />
              <div className="text-right">
                <span className="text-[10px] font-mono tracking-widest uppercase text-text-secondary block">
                  CÓDIGO DE AUTENTICIDADE
                </span>
                <span className="font-mono font-bold text-sm text-brand-primary bg-white px-2.5 py-1 rounded border border-border-subtle">
                  {receipt.verificationCode}
                </span>
              </div>
            </div>

            {/* Title */}
            <div className="my-6 text-center space-y-1">
              <h2 className="font-heading font-bold text-2xl text-brand-primary tracking-tight">
                Certificado de Arrematação Demonstrativo
              </h2>
              <p className="text-xs text-text-secondary">
                Pregão Eletrônico Homologado · Registro de Arremate em
                Plataforma Digital
              </p>
            </div>

            {/* Details Table */}
            <div className="bg-white rounded-xl border border-border-subtle overflow-hidden p-6 space-y-4 shadow-2xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                  <span className="text-text-secondary block text-[11px]">
                    Código do Lote:
                  </span>
                  <span className="font-mono font-bold text-brand-primary text-sm">
                    {receipt.lotCode}
                  </span>
                </div>
                <div>
                  <span className="text-text-secondary block text-[11px]">
                    Categoria:
                  </span>
                  <span className="font-medium text-text-primary">
                    {receipt.lotCategory}
                  </span>
                </div>
                <div className="sm:col-span-2">
                  <span className="text-text-secondary block text-[11px]">
                    Descrição da Peça:
                  </span>
                  <span className="font-heading font-semibold text-sm text-text-primary">
                    {receipt.lotTitle}
                  </span>
                </div>
              </div>

              <div className="pt-4 border-t border-border-subtle grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                <div>
                  <span className="text-text-secondary block text-[11px]">
                    Licitante Vencedor:
                  </span>
                  <span className="font-mono font-semibold text-brand-primary">
                    {receipt.winnerPseudonym}
                  </span>
                  <span className="text-[10px] text-text-secondary block">
                    ({receipt.winnerName})
                  </span>
                </div>

                <div>
                  <span className="text-text-secondary block text-[11px]">
                    Data de Encerramento:
                  </span>
                  <span className="font-medium text-text-primary">
                    {formatDateTimeBR(receipt.closedAt)}
                  </span>
                </div>

                <div>
                  <span className="text-text-secondary block text-[11px]">
                    Valor de Arremate:
                  </span>
                  <span className="font-heading font-bold text-base text-brand-primary">
                    {formatBRL(receipt.finalPriceCents)}
                  </span>
                </div>
              </div>

              <div className="pt-3 border-t border-border-subtle flex items-center justify-between text-[11px] text-text-secondary">
                <span>Leiloeiro Conducente: {receipt.sellerName}</span>
                <span className="inline-flex items-center gap-1 text-semantic-success font-medium">
                  <CheckCircle2 className="w-3.5 h-3.5" />
                  <span>Liquidação Simulada Concluída</span>
                </span>
              </div>
            </div>

            {/* Mandatory Public Warning */}
            <div className="mt-6 p-4 rounded-xl bg-semantic-warning-bg/40 border border-[#B45309]/30 text-[11px] text-text-primary space-y-1">
              <p className="font-semibold text-semantic-warning">
                Aviso Legal Demonstrativo:
              </p>
              <p className="text-text-secondary leading-relaxed">
                Este comprovante demonstra o encerramento do lote dentro de uma
                plataforma com saldo e lances simulados. Não constitui nota
                fiscal, escritura pública, comprovante de pagamento real ou
                garantia de autenticidade material.
              </p>
            </div>

            {/* Verification footer — apenas o que a plataforma realmente faz */}
            <div className="mt-8 pt-6 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 bg-white rounded-lg border border-border-subtle p-1 flex items-center justify-center">
                  <QrCode className="w-10 h-10 text-brand-primary" />
                </div>
                <div className="text-[10px] text-text-secondary">
                  <p className="font-mono text-brand-primary font-bold">
                    VERIFICAÇÃO PÚBLICA
                  </p>
                  <p>Consulte este código em {shareUrl}</p>
                  <p>
                    Eventos encadeados por hash SHA-256 na trilha de auditoria
                  </p>
                </div>
              </div>

              <div className="text-center sm:text-right">
                <div className="w-48 h-0.5 bg-[#CDC5B4] mb-1"></div>
                <p className="text-[11px] font-semibold text-brand-primary">
                  Lance Casa de Leilões Digitais
                </p>
                <p className="text-[10px] text-text-secondary">
                  Comprovante de liquidação simulada — sem valor fiscal
                </p>
              </div>
            </div>
          </div>
        </div>
      </motion.div>
    </div>
  );
};
