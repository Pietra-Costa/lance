# ---------------------------------------------------------------
# Lance API - variaveis de ambiente
# Copie para `.env` e ajuste os valores:
#   cp apps/api/.env.example apps/api/.env
# NUNCA comite o `.env` com valores reais.
# ---------------------------------------------------------------

# Conexao com o PostgreSQL.
# Docker Compose local: postgresql://lance:lance_dev@localhost:5432/lance
DATABASE_URL="postgresql://lance:lance_dev@localhost:5432/lance?schema=public"

# Segredo usado para assinar os access tokens JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-64-caracteres"

# Senha das contas de demonstracao criadas pelo seed (minimo 10 caracteres).
# Nunca reutilize este valor em producao.
SEED_DEMO_PASSWORD="senhaDemoForte2026"

# Origens permitidas no CORS, separadas por virgula.
# Em desenvolvimento com Vite: http://localhost:5173
WEB_ORIGIN="http://localhost:5173"

# Porta HTTP da API (padrao 4000).
PORT=4000
