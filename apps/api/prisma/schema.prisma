
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEILOEIRO
  LICITANTE
}

enum CatalogSource {
  MET
  ART_INSTITUTE_CHICAGO
  MUSICBRAINZ
}

enum LotStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum ImageUsageStatus {
  UNKNOWN
  ALLOWED
  RESTRICTED
  EXTERNAL_ONLY
}

enum WalletTransactionType {
  DEPOSIT
  WINNER_DEBIT
  SELLER_CREDIT
}

enum BidReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerAgreements SellerAgreement[]
  wallet           Wallet?
  createdLots      Lot[]              @relation("LotSeller")
  leadingLots      Lot[]              @relation("LotLeader")
  bids             Bid[]              @relation("Bidder")
  notifications    Notification[]
  bidRequests BidRequest[]
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SellerAgreement {
  id          String   @id @default(cuid())
  userId      String
  version     String
  contentHash String
  acceptedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, version])
  @@index([userId, acceptedAt])
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balanceCents  Int      @default(0)
  reservedCents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  reservations BidReservation[]
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           WalletTransactionType
  amountCents    Int
  idempotencyKey String                @unique
  referenceType  String
  referenceId    String
  description    String?
  createdAt      DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
}

model CatalogItem {
  id          String        @id @default(cuid())
  source      CatalogSource
  externalId  String
  title       String
  description String?
  category    String?
  creator     String?
  sourceUrl   String?
  attributes  Json?
  importedAt  DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images    CatalogItemImage[]
  snapshots LotItemSnapshot[]

  @@unique([source, externalId])
  @@index([title])
  @@index([category])
}

model CatalogItemImage {
  id            String           @id @default(cuid())
  catalogItemId String
  sourceUrl     String
  storageKey    String?
  usageStatus   ImageUsageStatus @default(UNKNOWN)
  attribution   String?
  rightsNotes   String?
  createdAt     DateTime         @default(now())

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([catalogItemId])
}

model Lot {
  id                 String    @id @default(cuid())
  sellerId           String
  currentLeaderId    String?
  status             LotStatus @default(SCHEDULED)
  startingPriceCents Int
  currentPriceCents  Int       @default(0)
  minIncrementCents  Int       @default(1)
  startsAt           DateTime
  endsAt             DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  seller       User               @relation("LotSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  currentLeader User?              @relation("LotLeader", fields: [currentLeaderId], references: [id], onDelete: Restrict)
  itemSnapshot LotItemSnapshot?
  bids         Bid[]
  reservations BidReservation[]
  settlement   AuctionSettlement?
  bidRequests BidRequest[]

  @@index([status, startsAt, endsAt])
  @@index([sellerId])
  @@index([currentLeaderId])
}

model LotItemSnapshot {
  id               String        @id @default(cuid())
  lotId            String        @unique
  catalogItemId    String?
  title            String
  description      String?
  source           CatalogSource?
  externalId       String?
  attributes       Json?
  imageUrl         String?
  imageAttribution String?
  sourceUrl        String?
  snapshotAt       DateTime      @default(now())

  lot         Lot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([catalogItemId])
}

model Bid {
  id          String   @id @default(cuid())
  lotId       String
  bidderId    String
  amountCents Int
  createdAt   DateTime @default(now())

  lot         Lot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bidder      User               @relation("Bidder", fields: [bidderId], references: [id], onDelete: Restrict)
  reservation BidReservation?
  settlement  AuctionSettlement? @relation("WinningBid")
  request BidRequest?

  @@index([lotId, amountCents])
  @@index([bidderId, createdAt])
}


model BidRequest {
  id             String   @id @default(cuid())
  bidderId       String
  lotId          String
  idempotencyKey String
  requestHash    String
  response       Json?
  bidId          String?  @unique
  createdAt      DateTime @default(now())

  bidder User  @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  lot    Lot   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bid    Bid?  @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@unique([bidderId, idempotencyKey])
  @@index([lotId, createdAt])
}

model BidReservation {
  id          String               @id @default(cuid())
  walletId    String
  lotId       String
  bidId       String               @unique
  amountCents Int
  status      BidReservationStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  lot    Lot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bid    Bid    @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([lotId, status])
  @@index([walletId, status])
}

model AuctionSettlement {
  id           String           @id @default(cuid())
  lotId        String           @unique
  winningBidId String?          @unique
  amountCents  Int
  status       SettlementStatus @default(PENDING)
  settledAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lot        Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  winningBid Bid?    @relation("WinningBid", fields: [winningBidId], references: [id], onDelete: Restrict)
  receipt    Receipt?
}

model Receipt {
  id               String   @id @default(cuid())
  settlementId     String   @unique
  verificationCode String   @unique
  snapshot         Json
  issuedAt         DateTime @default(now())

  settlement AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id              String   @id @default(cuid())
  sequence        BigInt   @unique @default(autoincrement())
  eventType       String
  entityType      String
  entityId        String
  payload         Json
  previousHash    String?
  eventHash       String   @unique
  anchorReference String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model AuditChainState {
  id            String   @id @default("global")
  lastSequence  BigInt   @default(0)
  lastEventHash String?
  checkpointHash String?
  signature     String?
  anchoredAt    DateTime?
  updatedAt     DateTime @updatedAt
}

model OutboxEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
  lastError     String?

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
}
